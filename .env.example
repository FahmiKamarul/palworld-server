# Copy to .env and fill in:   cp .env.example .env && nano .env
# .env is gitignored — never commit real values.

# Password for admin commands (in-game /AdminPassword and the REST API)
ADMIN_PASSWORD=change-me

# Discord channel webhook (Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
# Leave empty to disable Discord messages.
DISCORD_WEBHOOK_URL=
